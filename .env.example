# =========================
# Marquez (Postgres database)
# =========================
# DB settings used by the Postgres container for Marquez.
POSTGRES_DB=marquez
POSTGRES_USER=marquez
POSTGRES_PASSWORD=marquez

# =========================
# Marquez (API service)
# =========================
# JDBC URL the Marquez API uses to reach Postgres (inside the compose network).
MARQUEZ_DB_URL=jdbc:postgresql://marquez-db:5432/marquez
# DB user/password that the Marquez API will use.
MARQUEZ_DB_USER=marquez
MARQUEZ_DB_PASSWORD=marquez
# Marquez API port (container listens on 5000; you map it in compose).
MARQUEZ_PORT=5000


MARIADB_HOST=127.0.0.1
MARIADB_USER=root
MARIADB_PASSWORD=root
MARIADB_DB=demo

# Symbols & range
TW_SYMBOLS=2330,2317,2303,0050.TW
START_DATE=2024-01-01
END_DATE=auto

# MariaDB
MARIADB_URL=mysql+pymysql://user:password@mariadb:3306/market

# HDFS/Hive (Compose names)
HDFS_PATH=/data/stocks
HIVE_HOST=hive-server
HIVE_PORT=10000
HIVE_DB=default